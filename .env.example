# ==============================================================================
# AMRUTAM TELEMEDICINE BACKEND CONFIGURATION
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Service URLs & Base Paths
API_BASE_URL=http://localhost:3000

# Database Connectivity (PostgreSQL 15+)
DATABASE_URL=postgresql://amrutam_user:amrutam_secure_pass@localhost:5432/amrutam_telemedicine?schema=public
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Cache & BullMQ Queue
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=60

# JWT & Authentication Security
JWT_ACCESS_SECRET=amrutam_jwt_super_secret_access_key_change_in_production_32chars
JWT_REFRESH_SECRET=amrutam_jwt_super_secret_refresh_key_change_in_production_32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
TOTP_ISSUER=AmrutamTelemedicine

# PHI Data Encryption (AES-256-GCM - must be 32 bytes / 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting (Token Bucket / Sliding Window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Observability & Metrics
PROMETHEUS_METRICS_ENABLED=true
OTEL_SERVICE_NAME=amrutam-telemedicine-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# External Providers (Mock / Sandbox)
PAYMENT_PROVIDER_MODE=mock
NOTIFICATION_PROVIDER_MODE=console
